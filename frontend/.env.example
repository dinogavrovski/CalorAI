# Backend API Configuration
# Update base URL based on your environment

# Development (local backend)
REACT_APP_API_BASE_URL=http://localhost:8000

# Production (update with your production URL)
# REACT_APP_API_BASE_URL=https://api.yourdomain.com

# Note: For Expo apps on physical devices, use your machine's IP instead of localhost
# Example: REACT_APP_API_BASE_URL=http://192.168.1.100:8000
