<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CalorAI" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">#FF0F0F0F</item>
    </style>

    <style name="Theme.CalorAI.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#FF0F0F0F</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.CalorAI</item>
    </style>
</resources>
